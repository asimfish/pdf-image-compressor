# PaperSqueeze configuration - copy to your deployment environment as needed.
# Every variable is optional; defaults are shown below.

# Enable the anonymous, stateless public site (landing page + single-file
# compression only; the local library API is disabled).
PDF_COMPRESSOR_PUBLIC_MODE=1

# Optional password gate for public deployments. When set, visitors must
# enter this password once; the browser then stays authenticated for 30 days.
# Leave unset for a fully open site. Never commit a real password.
#PDF_COMPRESSOR_ACCESS_PASSWORD=

# Per-file upload cap in MiB (1-500). Public mode defaults to 30,
# library mode to 500. Cloud Run's HTTP/1 request cap is 32 MiB.
PDF_COMPRESSOR_MAX_UPLOAD_MB=30

# Public-mode page cap (1-2000).
PDF_COMPRESSOR_MAX_PAGES=100

# Public-mode total upload window in seconds (10-900).
PDF_COMPRESSOR_UPLOAD_TIMEOUT_SECONDS=120

# Public-mode compression cap in seconds (30-1800); the isolated worker
# process is killed on timeout.
PDF_COMPRESSOR_PROCESSING_TIMEOUT_SECONDS=300

# Public-mode download window in seconds (10-900); temp files are cleaned
# up on timeout.
PDF_COMPRESSOR_DOWNLOAD_TIMEOUT_SECONDS=120

# Compression requests accepted per instance per minute (1-120).
PDF_COMPRESSOR_RATE_LIMIT_PER_MINUTE=12

# Concurrent compression jobs per instance (1-4).
PDF_COMPRESSOR_CONCURRENCY=1

# Container listen port.
PORT=8080
